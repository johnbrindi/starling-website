# Starling Wi-Fi configuration. Copy to .env (development) or .env.production (server).
# Every variable is documented in docs/environment-variables.md. Generate secrets: npm run keys:generate
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Starling Wi-Fi"
TZ=Africa/Douala

# PostgreSQL. Supabase: use the IPv4 *session pooler* (port 5432) unless your server has IPv6.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"
# Recommended in production: Supabase root CA (Dashboard > Database > SSL) for verified TLS.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
TRUST_PROXY=false

# Payments: simulator (dev only, refused in production) | notchpay
PAYMENT_PROVIDER=simulator
ALLOW_SIMULATED_PAYMENTS=true
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=

# Network: fake (dev only, refused in production) | routeros | radius
NETWORK_ADAPTER=fake
ALLOW_FAKE_NETWORK=true
ROUTER_HOST=
ROUTER_PORT=8729
ROUTER_TLS=true
ROUTER_TLS_INSECURE=true
ROUTER_USERNAME=starling-api
ROUTER_PASSWORD=
ROUTER_HOTSPOT_SERVER=hotspot1
ROUTER_TIMEOUT_MS=8000
HOTSPOT_LOGIN_URL=http://10.5.50.1/login

# RADIUS option only
RADIUS_NAS_HOST=
RADIUS_COA_PORT=3799
RADIUS_SECRET=

# Web Push (optional; reminders while the app is closed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

LOG_LEVEL=info
WORKER_INTERVAL_MS=5000
