/ip hotspot user profile set [find where name="1month"] shared-users=2 rate-limit=2M/5M idle-timeout=none keepalive-timeout=3h status-autorefresh=1m add-mac-cookie=yes mac-cookie-timeout=3d on-login=":local u \$user\r\n:local n (\"exp-\" . \$u)\r\n:if ([:len [/system scheduler find where name=\$n]] = 0) do={\r\n/system scheduler add name=\$n interval=30d policy=read,write,test comment=\"Starling: ends this hotspot user's time\" on-event=(\":do {/ip hotspot active remove [find where user=\\\"\" . \$u . \"\\\"]} on-error={}; :do {/ip hotspot cookie remove [find where user=\\\"\" . \$u . \"\\\"]} on-error={}; :do {/ip hotspot user remove [find where name=\\\"\" . \$u . \"\\\"]} on-error={}; /system scheduler remove [find where name=\\\"\" . \$n . \"\\\"]\")\r\n:delay 1s\r\n:local c \"\"\r\n:do {:set c [/ip hotspot user get [find where name=\$u] comment]} on-error={}\r\n:if ([:len \$c] > 0) do={:set c (\$c . \" | \")}\r\n:do {/ip hotspot user set [find where name=\$u] comment=(\$c . \"Started \" . [/system clock get date] . \" \" . [/system clock get time] . \" | ends \" . [/system scheduler get [find where name=\$n] next-run])} on-error={}\r\n}"
