:if ([:len [/ip hotspot user profile find where name="family"]] = 0) do={ /ip hotspot user profile add name="family" }
/ip hotspot user profile set [find where name="family"] shared-users=2 rate-limit=5M/10M idle-timeout=none keepalive-timeout=3h status-autorefresh=1m add-mac-cookie=yes mac-cookie-timeout=30d on-login=""
:put "Profile family (free, never expires, 2 device(s), 5M/10M) ready"
