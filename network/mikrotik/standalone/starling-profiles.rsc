# Juthelink - hotspot packages (user profiles) with automatic expiry.
# Generated by build_profiles.py. Import on the router:  /import file-name=starling-profiles.rsc
# Time starts at the customer's FIRST login and ends DURATION later (wall clock), even if they log off.
# Safe to import again, even with customers online: existing profiles are updated in place.

:if ([:len [/ip hotspot user profile find where name="1hour"]] = 0) do={ /ip hotspot user profile add name="1hour" }
/ip hotspot user profile set [find where name="1hour"] shared-users=1 rate-limit=2M/5M idle-timeout=none keepalive-timeout=3h status-autorefresh=1m add-mac-cookie=yes mac-cookie-timeout=3d on-login=":local u \$user\r\n:local n (\"exp-\" . \$u)\r\n:if ([:len [/system scheduler find where name=\$n]] = 0) do={\r\n/system scheduler add name=\$n interval=1h policy=read,write,test comment=\"Starling: ends this hotspot user's time\" on-event=(\":do {/ip hotspot active remove [find where user=\\\"\" . \$u . \"\\\"]} on-error={}; :do {/ip hotspot cookie remove [find where user=\\\"\" . \$u . \"\\\"]} on-error={}; :do {/ip hotspot user remove [find where name=\\\"\" . \$u . \"\\\"]} on-error={}; /system scheduler remove [find where name=\\\"\" . \$n . \"\\\"]\")\r\n:delay 1s\r\n:local c \"\"\r\n:do {:set c [/ip hotspot user get [find where name=\$u] comment]} on-error={}\r\n:if ([:len \$c] > 0) do={:set c (\$c . \" | \")}\r\n:do {/ip hotspot user set [find where name=\$u] comment=(\$c . \"Started \" . [/system clock get date] . \" \" . [/system clock get time] . \" | ends \" . [/system scheduler get [find where name=\$n] next-run])} on-error={}\r\n}"
:put "Profile 1hour (1h, 105 FCFA, 1 device(s)) ready"
:if ([:len [/ip hotspot user profile find where name="12hours"]] = 0) do={ /ip hotspot user profile add name="12hours" }
/ip hotspot user profile set [find where name="12hours"] shared-users=1 rate-limit=2M/5M idle-timeout=none keepalive-timeout=3h status-autorefresh=1m add-mac-cookie=yes mac-cookie-timeout=3d on-login=":local u \$user\r\n:local n (\"exp-\" . \$u)\r\n:if ([:len [/system scheduler find where name=\$n]] = 0) do={\r\n/system scheduler add name=\$n interval=12h policy=read,write,test comment=\"Starling: ends this hotspot user's time\" on-event=(\":do {/ip hotspot active remove [find where user=\\\"\" . \$u . \"\\\"]} on-error={}; :do {/ip hotspot cookie remove [find where user=\\\"\" . \$u . \"\\\"]} on-error={}; :do {/ip hotspot user remove [find where name=\\\"\" . \$u . \"\\\"]} on-error={}; /system scheduler remove [find where name=\\\"\" . \$n . \"\\\"]\")\r\n:delay 1s\r\n:local c \"\"\r\n:do {:set c [/ip hotspot user get [find where name=\$u] comment]} on-error={}\r\n:if ([:len \$c] > 0) do={:set c (\$c . \" | \")}\r\n:do {/ip hotspot user set [find where name=\$u] comment=(\$c . \"Started \" . [/system clock get date] . \" \" . [/system clock get time] . \" | ends \" . [/system scheduler get [find where name=\$n] next-run])} on-error={}\r\n}"
:put "Profile 12hours (12h, 155 FCFA, 1 device(s)) ready"
